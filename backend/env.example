# MongoDB Connection
MONGODB_URI=mongodb://localhost:27017/educhain

# JWT Secret for Authentication
JWT_SECRET=your_super_secret_jwt_key_here

# Email Configuration (for password reset)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password

# SMTP Configuration (for OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password

# Twilio SMS Configuration (for phone OTP verification)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+1234567890

# Pinata IPFS Configuration
PINATA_API_KEY=your_pinata_api_key_here
PINATA_SECRET_API_KEY=your_pinata_secret_api_key_here

# GPTZero API Configuration (for plagiarism detection)
GPTZERO_API_KEY=your_gptzero_api_key_here

# Ethereum Blockchain Configuration
ETHEREUM_NETWORK_URL=https://sepolia.infura.io/v3/your_project_id
NFT_CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
PRIVATE_KEY=your_private_key_for_signing_transactions

# Server Configuration
PORT=5000
NODE_ENV=development



